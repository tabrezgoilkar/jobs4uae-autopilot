# Copy this file to `.env.local` for a local cloud preview, or add these as
# Environment Variables in the Vercel dashboard (Settings -> Environment Variables).
# All CLERK_* vars are REQUIRED for a production cloud deploy (auth must not fail open).

# --- Clerk auth (https://clerk.com) ---
# Server secret key — required in production or the cloud app refuses to boot.
CLERK_SECRET_KEY=sk_live_xxx
# Comma-separated allowed frontend origin(s), e.g. https://your-app.vercel.app
CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app

# --- Clerk publishable key (browser; used by the web app) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# --- Optional: Neon Postgres for per-user storage that survives serverless cold starts ---
# If omitted, the cloud app uses a per-server store (fine for light use).
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Local dev only ---
# Not needed for the cloud build. Local dev runs as the 'local' user with no login
# when CLERK_SECRET_KEY is unset.
# NODE_ENV=development
# PORT=5123
# JOBS4UAE_DATA_DIR=./data
