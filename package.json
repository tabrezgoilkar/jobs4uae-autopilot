{
  "name": "jobs4uae-autopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "cross-env NO_OPEN=1 nodemon server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.3",
    "@neondatabase/serverless": "^1.1.0",
    "cheerio": "^1.2.0",
    "express": "^4.19.2",
    "mammoth": "^1.12.0",
    "marked": "^14.1.4",
    "multer": "^1.4.5-lts.1",
    "open": "^10.1.0",
    "pdf-parse": "^1.1.4",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
